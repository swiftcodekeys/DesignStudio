  "model_id_rules": {
    "rails_top": "rtI = 'rt' + stlI [+ 'c' if circles]",
    "rails_bottom": "rbI = 'rbs' always",
    "picket_top": "ptI = 'pt' + cat + pi [+ 'c' if circles and pi=201]",
    "picket_bottom": "pbI = (pi==201 || pi==101) ? 'pbd' : 'pbs'",
    "finials": "finI = 'fn' + mod + finT where finT = s|t|q",
    "finials_gate_section": "gfinI = (mod==150||300||350) ? 'fn100'+finT : finI",
    "puppy": "pupI = 'pupcl' | 'pupst'",
    "post_caps": "pcI = 'pcf'",
    "accents": "accir | acbut | acscr"
  },

